{
  "name": "lineleaf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && python3 scripts/package.py",
    "test": "npm run test:python && npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/extension.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:browser": "npm run build && node --test tests/editor.test.mjs tests/selection.test.mjs tests/inline.test.mjs",
    "test:extension": "npm run build && node --test tests/installed-extension.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.62.1"
  }
}
