{
  "manifest_version": 3,
  "name": "Lineleaf",
  "version": "0.1.0",
  "description": "Clearer writing. Still your words. Proofread and rewrite selections through your shared Seatline companion.",
  "minimum_chrome_version": "124",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "icons": {
    "16": "icons/lineleaf-16.png",
    "32": "icons/lineleaf-32.png",
    "48": "icons/lineleaf-48.png",
    "128": "icons/lineleaf-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lineleaf",
    "default_icon": {
      "16": "icons/lineleaf-16.png",
      "32": "icons/lineleaf-32.png",
      "48": "icons/lineleaf-48.png",
      "128": "icons/lineleaf-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
